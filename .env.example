# 1. ASSISTANT IA & TRADUCTION CULINAIRE (Serveur / Backend)
# Requis pour l'assistant sommelier AllôChef et les traductions automatiques en Haoussa/Zarma.
GEMINI_API_KEY=

# 2. BASE DE DONNÉES & AUTHENTIFICATION (Supabase PostgreSQL)
# URL publique de votre projet Supabase (ex: https://votre-projet.supabase.co)
VITE_SUPABASE_URL=
# Clé publique anonyme du projet Supabase (uniquement la clé publique anon / publishable, utilisable dans le navigateur)
VITE_SUPABASE_ANON_KEY=
# Clé de service Supabase (ATTENTION: Strictement réservée au backend / Edge Functions - JAMAIS dans le frontend ni en VITE_*)
SUPABASE_SERVICE_ROLE_KEY=

# 3. COMPTES DÉPÔTS & NUMÉROS OFFICIELS NIGER (Paiements Locaux & Support)
# Numéros des comptes marchands / agences pour la validation par capture de reçu
VITE_MYNITA_DEPOSIT_NUMBER=+227 90 40 51 18
VITE_AMANATA_DEPOSIT_NUMBER=+227 90 40 51 18
VITE_AL_IZZA_BUSINESS_NUMBER=+227 90 40 51 18
VITE_ZEYNA_DEPOSIT_NUMBER=+227 90 40 51 18
VITE_AIRTEL_MONEY_NIGER_NUMBER=+227 96 05 23 10
VITE_ALLORESTO_WHATSAPP_SUPPORT=+227 70 03 25 52

# Aliases sans préfixe VITE (compatibles backend / conteneurs)
MYNITA_DEPOSIT_NUMBER=+227 90 40 51 18
AMANATA_DEPOSIT_NUMBER=+227 90 40 51 18
AL_IZZA_BUSINESS_NUMBER=+227 90 40 51 18
